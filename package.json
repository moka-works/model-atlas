{
  "name": "model-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A static, curated atlas of model APIs, capabilities and public pricing.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "watch": "node scripts/watch/check.mjs",
    "watch:update": "node scripts/watch/check.mjs --update"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
